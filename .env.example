AGNES_API_KEY=your_agnes_api_key
JWT_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_INVITE=
# Optional absolute path; default is <project>/data
# DATA_DIR=/path/to/data
# Dev (Vite): http://localhost:5173 | Docker local: * | Prod: https://your.domain
CORS_ORIGINS=http://localhost:5173
# Docker Compose (local) host port
APP_PORT=8080
# Auto-review pipeline: max fix attempts after first generation; min score 0–10 to accept
AUTO_REVIEW_MAX_FIXES=2
AUTO_REVIEW_PASS_SCORE=7

# --- Production (docker-compose.prod.yml + Traefik / Let's Encrypt) ---
DOMAIN=example.com
ACME_EMAIL=admin@example.com
# Optional: Let's Encrypt staging CA while testing cert issuance (comment out for real certs)
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

