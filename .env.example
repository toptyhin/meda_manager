AGNES_API_KEY=your_agnes_api_key
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_VIDEO_MODEL=agnes-video-v2.0
JWT_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_INVITE=
# Optional absolute path; default is <project>/data
# DATA_DIR=/path/to/data
# Database: empty = local SQLite under DATA_DIR; for Postgres use asyncpg URL
# DATABASE_URL=postgresql+asyncpg://media:secret@localhost:5432/media_manager
# Postgres container (docker-compose): user/db default to media/media_manager
# POSTGRES_USER=media
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=media_manager
# Telegram Mini App auth (initData HMAC validation); empty = /api/auth/telegram disabled
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_INIT_DATA_MAX_AGE=86400
# Dev (Vite): http://localhost:5173 | Docker local: * | Prod: https://your.domain + https://t.your.domain
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public base URL for signed image links (required for i2v / keyframes and auto-review)
# Must be reachable by Agnes servers (not localhost). Locally use a tunnel.
# PUBLIC_BASE_URL=https://your.domain
# Docker Compose (local) host port
APP_PORT=8080
# Auto-review pipeline: max fix attempts after first generation; min score 0–10 to accept
AUTO_REVIEW_MAX_FIXES=2
AUTO_REVIEW_PASS_SCORE=7
# Video generation polling
# VIDEO_POLL_INTERVAL=5
# VIDEO_POLL_TIMEOUT=900
# MEDIA_LINK_TTL=3600

# --- Production (docker-compose.prod.yml + Traefik / Let's Encrypt) ---
# Main SPA: https://$DOMAIN
# Telegram Mini App: https://t.$DOMAIN  (DNS A/AAAA for t.$DOMAIN required)
DOMAIN=example.com
ACME_EMAIL=admin@example.com
# CORS_ORIGINS=https://example.com,https://t.example.com
# Optional: Let's Encrypt staging CA while testing cert issuance (comment out for real certs)
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

